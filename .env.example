# Copy to .env (not .env.local — Next reads both, and .env.local wins, so
# keeping two copies only makes values harder to trace).
#
# --- Ondros CMS connection ---------------------------------------------------
# Server-side origin. In Docker this can be an internal hostname.
CMS_URL=http://localhost:8000
# Browser-side origin, used for the Code Sync bridge script tag. Defaults to
# CMS_URL — set it when the two differ (internal vs public hostname).
NEXT_PUBLIC_CMS_URL=http://localhost:8000

CMS_SPACE_ID=
CMS_ENVIRONMENT=master

# Published content (cms_del_…). Used for normal visitors.
CMS_DELIVERY_TOKEN=

# Draft content (cms_pre_…). Required for previewing inside the Ondros editor —
# without it the editor shows published content and edits appear not to save.
CMS_PREVIEW_TOKEN=

# Verifies that a preview request really came from the editor (ondros_pv_…).
# Copy it from Settings -> Code Sync in the CMS.
#
# This is a credential, not a setting. The preview token above reads every
# unpublished entry in the space, and this secret is the only thing deciding
# who gets to spend it: without it, anyone who is sent a preview URL reads
# your drafts. Never commit it, and never expose it as NEXT_PUBLIC_*.
ONDROS_PREVIEW_SECRET=

# Write access (cms_mgm_…). Only needed to run scripts/seed-content.mjs, which
# creates this site's content model and copy. Not used by the site itself.
CMS_MANAGEMENT_TOKEN=
